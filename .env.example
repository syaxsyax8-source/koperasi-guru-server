# Untuk development (localhost) - kosongkan saja, otomatis pakai proxy Vite
VITE_SERVER_URL=

# Untuk production (Netlify) - isi URL server backend yang sudah di-deploy
# Contoh pakai Railway:
# VITE_SERVER_URL=https://koperasi-guru-server.railway.app
#
# Contoh pakai Render:
# VITE_SERVER_URL=https://koperasi-guru-server.onrender.com
